{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhenti-judu",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zhenti-judu-prod",
      "database_id": "07579767-4ace-4097-a9e8-06814ded6e53"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
